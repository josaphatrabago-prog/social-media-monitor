# ---------------------------------------------------------------------------
# Social Media Monitor - secrets
# Copy to ".env" and fill in the values you actually have.
# Every key is optional: any platform without credentials is simply skipped
# (or served from the mock generator when mock mode is on).
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=3000
HOST=127.0.0.1

# Optional shared secret. When set, the dashboard and API require
# "?token=..." or an "X-Monitor-Token" header.
MONITOR_TOKEN=

# --- Facebook / Instagram (Meta Graph API) ----------------------------------
# Needs a long-lived Page token with: pages_read_engagement,
# pages_read_user_content, instagram_basic, instagram_manage_comments.
FB_ACCESS_TOKEN=
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Which Facebook Pages / groups to read, comma separated. Not secret, but they
# arrive with the token they belong to, so setting them here means connecting a
# new Page needs no code change. Overrides platforms.facebook.pageIds.
#   FB_PAGE_IDS=101234567890123,109876543210987
FB_PAGE_IDS=
FB_GROUP_IDS=

# --- YouTube Data API v3 ----------------------------------------------------
# Google Cloud console -> APIs & Services -> YouTube Data API v3 -> API key.
YOUTUBE_API_KEY=

# --- TikTok -----------------------------------------------------------------
# TikTok has no public keyword-search endpoint, so pick a provider:
#   provider=apify          -> APIFY_TOKEN
#   provider=rapidapi       -> RAPIDAPI_KEY
#   provider=tiktok-research -> TIKTOK_RESEARCH_TOKEN (Research API, approval required)
APIFY_TOKEN=
RAPIDAPI_KEY=
TIKTOK_RESEARCH_TOKEN=

# --- Notification channels --------------------------------------------------
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# --- Email alerts (SMTP) ----------------------------------------------------
# Gmail: use an App Password, host smtp.gmail.com, port 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=
